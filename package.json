{
	"name": "pi-cybergrind",
	"version": "0.1.0",
	"private": true,
	"description": "Personal pi extensions — tmux scroll and friends",
	"keywords": ["pi-package"],
	"pi": {
		"extensions": ["./extensions"]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/*.test.ts",
		"test:subagent": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/subagent-smoke.ts",
		"test:interactive": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/subagent-interactive-smoke.ts",
		"test:all": "npm run test && npm run test:subagent && npm run test:interactive"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.80.7",
		"@earendil-works/pi-tui": "0.80.7",
		"@types/node": "^22.10.0",
		"typescript": "^6.0.0",
		"typescript-language-server": "^5.3.0"
	}
}
